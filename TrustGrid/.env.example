# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://trustgrid_user:your_password_here@localhost:5432/trustgrid_db

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# ── CORS ───────────────────────────────────────────────────────────────────────
FRONTEND_ORIGIN=http://localhost:5173

# ── TrustGrid defaults ─────────────────────────────────────────────────────────
INITIAL_TRUST_SCORE=700
TIME_DECAY_HALF_LIFE_DAYS=90
